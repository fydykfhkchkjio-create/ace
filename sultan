-- السحب والإفلات للواجهة
local function startDrag(inputPos)
	isDragging = true
	dragStart = inputPos
	frameStart = mainFrame.Position
end
local function updateDrag(inputPos)
	if not isDragging or not dragStart or not frameStart then return end
	local delta = inputPos - dragStart
	local newPos = frameStart + UDim2.new(0, delta.X, 0, delta.Y)
	TweenService:Create(mainFrame, TweenInfo.new(0.05), {Position = newPos}):Play()
	TweenService:Create(shadowFrame, TweenInfo.new(0.05), {Position = newPos + UDim2.new(0, -7, 0, -7)}):Play()
end
local function stopDrag()
	isDragging = false
	dragStart = nil
	frameStart = nil
end

titleLabelGui.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		startDrag(input.Position)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		updateDrag(input.Position)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		stopDrag()
	end
end)

